# ---------- Site ----------
# Public URL, used for links in emails, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Database ----------
# Production: a PostgreSQL connection string.
# Leave empty in development to use the built-in PGlite database stored in .data/pglite
DATABASE_URL=

# ---------- First administrator (used by `npm run db:seed` / `npm run admin:create`) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Administrator

# ---------- Email (SMTP) ----------
# When SMTP_HOST is empty, emails are not sent. They are recorded in the
# admin "Email log" so you can see exactly what would have gone out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="MindsNova Hub <no-reply@example.org>"
# Where new application / inquiry notifications go (comma separated)
ADMIN_NOTIFY_EMAILS=

# ---------- Spam protection (optional, Cloudflare Turnstile) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Analytics (optional) ----------
# Google Analytics 4 measurement ID. Only loaded after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# ---------- Search engine verification (optional) ----------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------- Uploads ----------
# Folder where uploaded images and documents are stored.
UPLOAD_DIR=.data/uploads
