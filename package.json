{
  "name": "mindsnova-hub",
  "version": "1.0.0",
  "private": true,
  "description": "MindsNova Hub website: public site, application system and admin dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
